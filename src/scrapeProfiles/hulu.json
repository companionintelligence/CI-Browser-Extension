{
  "domain": "hulu.com",
  "name": "Hulu Data Scraper",
  "description": "Scrapes Hulu account data, viewing history, and watchlist",
  "targetUrl": [
    "https://secure.hulu.com/account*",
    "https://secure.hulu.com/*",
    "https://www.hulu.com/my-stuff*",
    "https://www.hulu.com/profiles*"
  ],
  "dataSelectors": {
    "accountInfo": {
      "container": ".account-info, .profile-info, .user-details, .account-section",
      "fields": {
        "email": {
          "selector": ".email, .account-email, input[type='email']",
          "type": "text",
          "transform": "trim"
        },
        "planType": {
          "selector": ".plan-type, .subscription-plan, .current-plan",
          "type": "text",
          "transform": "trim"
        },
        "billingDate": {
          "selector": ".billing-date, .next-billing, .renewal-date",
          "type": "text",
          "transform": "trim"
        },
        "accountSince": {
          "selector": ".account-since, .member-since, .created-date",
          "type": "text",
          "transform": "trim"
        }
      }
    },
    "watchHistory": {
      "container": ".watch-history-item, .history-item, .viewing-activity-row",
      "fields": {
        "title": {
          "selector": ".title, .show-title, .content-title, a",
          "type": "text",
          "transform": "trim"
        },
        "titleUrl": {
          "selector": "a, .title-link",
          "type": "attribute",
          "attribute": "href",
          "transform": "absoluteUrl"
        },
        "watchedDate": {
          "selector": ".date, .watched-date, .timestamp",
          "type": "text",
          "transform": "trim"
        },
        "episode": {
          "selector": ".episode, .episode-title, .episode-name",
          "type": "text",
          "transform": "trim"
        },
        "progress": {
          "selector": ".progress, .watch-progress, .completion",
          "type": "text",
          "transform": "trim"
        }
      }
    },
    "watchlist": {
      "container": ".watchlist-item, .my-stuff-item, .saved-item, .favorite-item",
      "fields": {
        "title": {
          "selector": ".title, .show-title, .content-title",
          "type": "text",
          "transform": "trim"
        },
        "titleUrl": {
          "selector": "a, .title-link",
          "type": "attribute",
          "attribute": "href",
          "transform": "absoluteUrl"
        },
        "addedDate": {
          "selector": ".added-date, .date-added, .timestamp",
          "type": "text",
          "transform": "trim"
        },
        "imageUrl": {
          "selector": "img, .poster-image, .thumbnail",
          "type": "attribute",
          "attribute": "src",
          "transform": "absoluteUrl"
        },
        "description": {
          "selector": ".description, .show-description, .synopsis",
          "type": "text",
          "transform": "trim"
        }
      }
    },
    "profiles": {
      "container": ".profile-item, .user-profile, .profile-card",
      "fields": {
        "profileName": {
          "selector": ".profile-name, .name, .username",
          "type": "text",
          "transform": "trim"
        },
        "profileImage": {
          "selector": "img, .profile-image, .avatar",
          "type": "attribute",
          "attribute": "src",
          "transform": "absoluteUrl"
        },
        "isKidsProfile": {
          "selector": ".kids-profile, .children-profile, .parental-controls",
          "type": "text",
          "transform": "trim"
        }
      }
    }
  },
  "dataTypes": [
    {
      "name": "account_info",
      "description": "Hulu account information and subscription details",
      "personalDataType": "account_data"
    },
    {
      "name": "viewing_history",
      "description": "Hulu viewing history and watch progress",
      "personalDataType": "entertainment_preferences"
    },
    {
      "name": "watchlist",
      "description": "Hulu saved watchlist and favorites",
      "personalDataType": "entertainment_preferences"
    },
    {
      "name": "user_profiles",
      "description": "Hulu user profiles and settings",
      "personalDataType": "account_data"
    }
  ]
}