{
  "domain": "cnn.com",
  "name": "CNN News Data Scraper",
  "description": "Scrapes CNN articles, headlines, and news content",
  "matchPatterns": [
    "*://*.cnn.com/*"
  ],
  "targetUrl": [
    "https://www.cnn.com/*",
    "https://edition.cnn.com/*"
  ],
  "dataSelectors": {
    "articles": {
      "personalDataType": "news_consumption",
      "container": "[data-testid='article'], .article, .card, .media, .list-item",
      "fields": {
        "headline": {
          "selector": "[data-testid='headline'], .headline, h1, h2, h3, .card-title",
          "type": "text",
          "transform": "trim"
        },
        "articleUrl": {
          "selector": "a",
          "type": "attribute",
          "attribute": "href",
          "transform": "absoluteUrl"
        },
        "summary": {
          "selector": "[data-testid='summary'], .summary, .description, .excerpt, p",
          "type": "text",
          "transform": "trim"
        },
        "imageUrl": {
          "selector": "img, .media-image",
          "type": "attribute",
          "attribute": "src",
          "transform": "absoluteUrl"
        },
        "publishDate": {
          "selector": "[data-testid='publish-date'], .publish-date, .timestamp, time",
          "type": "text",
          "transform": "trim"
        },
        "author": {
          "selector": "[data-testid='author'], .author, .byline",
          "type": "text",
          "transform": "trim"
        },
        "category": {
          "selector": "[data-testid='category'], .category, .section, .topic",
          "type": "text",
          "transform": "trim"
        }
      }
    },
    "breakingNews": {
      "personalDataType": "news_consumption",
      "container": "[data-testid='breaking-news'], .breaking-news, .alert, .urgent",
      "fields": {
        "headline": {
          "selector": "[data-testid='headline'], .headline, h1, h2",
          "type": "text",
          "transform": "trim"
        },
        "articleUrl": {
          "selector": "a",
          "type": "attribute",
          "attribute": "href",
          "transform": "absoluteUrl"
        },
        "timestamp": {
          "selector": "[data-testid='timestamp'], .timestamp, time",
          "type": "text",
          "transform": "trim"
        }
      }
    },
    "headlines": {
      "personalDataType": "news_consumption",
      "container": "[data-testid='headline-item'], .headline-item, .top-story, .featured",
      "fields": {
        "title": {
          "selector": "[data-testid='title'], .title, h1, h2, h3",
          "type": "text",
          "transform": "trim"
        },
        "url": {
          "selector": "a",
          "type": "attribute",
          "attribute": "href",
          "transform": "absoluteUrl"
        },
        "category": {
          "selector": "[data-testid='category'], .category, .section",
          "type": "text",
          "transform": "trim"
        }
      }
    }
  }
}
