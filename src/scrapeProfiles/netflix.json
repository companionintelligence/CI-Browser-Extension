{
  "domain": "netflix.com",
  "name": "Netflix Viewing History",
  "description": "Scrapes Netflix viewing history from the settings page",
  "targetUrl": "https://www.netflix.com/settings/viewed/*",
  "dataSelectors": {
    "viewingHistory": {
      "container": "[data-uia='retableRow'], .retableRow, tr, .title-container",
      "fields": {
        "date": {
          "selector": "[data-uia='date'], .date, td:first-child, .viewing-date",
          "type": "text",
          "transform": "trim"
        },
        "title": {
          "selector": "[data-uia='title'] a, .title a, td:nth-child(2) a, a[href*='/title/'], .title-link",
          "type": "text",
          "transform": "trim"
        },
        "titleUrl": {
          "selector": "[data-uia='title'] a, .title a, td:nth-child(2) a, a[href*='/title/'], .title-link",
          "type": "attribute",
          "attribute": "href",
          "transform": "absoluteUrl"
        },
        "watchedDateTime": {
          "selector": "[data-uia='date'], .date, td:first-child, .viewing-date",
          "type": "text",
          "transform": "parseDate"
        },
        "reportProblemUrl": {
          "selector": "a[href*='/reportproblem/'], .report-link",
          "type": "attribute",
          "attribute": "href",
          "transform": "absoluteUrl"
        },
        "removeUrl": {
          "selector": "a[href*='#']:last-child, .remove-link, .delete-link",
          "type": "attribute",
          "attribute": "href",
          "transform": "absoluteUrl"
        }
      }
    }
  },
  "dataTypes": [
    {
      "name": "viewing_history",
      "description": "Netflix viewing history entries with watch dates and titles",
      "personalDataType": "entertainment_preferences"
    }
  ]
}