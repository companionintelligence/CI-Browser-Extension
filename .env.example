# Build-time Sentry configuration for the extension background/popup bundles.
# Replay is intentionally not enabled: this extension handles browsing activity.
# VITE_SENTRY_DSN=https://<public-key>@o<org-id>.ingest.us.sentry.io/<project-id>
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=ci-browser-extension@1.4.0
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_ENABLE_METRICS=true
# VITE_SENTRY_ENABLE_LOGS=true
