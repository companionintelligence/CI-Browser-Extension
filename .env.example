# Build-time configuration for the Companion Intelligence browser extension.
#
# Copy to `.env` (git-ignored) to use locally. WXT exposes any `WXT_`-prefixed
# variable through `import.meta.env`, so these are BAKED INTO THE ARTIFACT at
# build time — an extension has no runtime environment.
#
# See docs/operations/error-reporting.md.

# ---------------------------------------------------------------------------
# Error reporting (Sentry) — OPT-OUT
# ---------------------------------------------------------------------------

# Sentry DSN for project `ci-browser-extension`. Leave UNSET for local
# development: with no DSN nothing initialises, no request is ever made, and the
# SDK is tree-shaken out of the bundle entirely.
#
# NOTE: a DSN compiled into a PUBLISHED extension cannot be revoked without a
# store update. The switch users can actually reach is the popup's "Send error
# reports" toggle, which overrides a baked-in DSN at runtime.
# WXT_SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<project>

# Kill switches for the BUILD. Either one produces an artifact that can never
# report, whatever the DSN says. They cannot help a user who already installed a
# build with a DSN — that is what the popup toggle is for.
# WXT_CI_TELEMETRY=off        # off | false | 0 | no | disabled
# WXT_CI_LOCAL_ONLY=true      # true | 1 | yes | on | enabled

# Sentry environment. Defaults to "production" — a shipped extension is.
# WXT_SENTRY_ENV=development

# Release name. Defaults to ci-browser-extension@<manifest version>.
# WXT_SENTRY_RELEASE=ci-browser-extension@1.6.1
