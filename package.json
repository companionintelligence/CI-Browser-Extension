{
  "name": "ci-browser-extension",
  "description": "Companion Intelligence browser extension for Chrome and Firefox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt zip -b edge",
    "dev:safari": "wxt zip -b safari",
    "dev:opera": "wxt -b opera",
    "dev:brave": "wxt -b brave",
    "dev:duckduckgo": "wxt -b duckduckgo",
    "build:safari-mobile": "wxt zip -b safari --mv3",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "build:firefox": "wxt build -b firefox",
    "build:all": "npm run build && npm run build:firefox && npm run build:edge && npm run build:safari && npm run build:safari-mobile",
    "build:safari": "wxt build -b safari",
    "build:safari-mobile": "wxt build -b safari --mv3",
    "build:edge": "wxt build -b edge",
    "build:opera": "wxt build -b opera",
    "build:brave": "wxt build -b brave",
    "build:duckduckgo": "wxt build -b duckduckgo",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:safari": "wxt zip -b safari",
    "zip:safari-mobile": "wxt build -b safari --mv3 && cd .output && zip -r ci-browser-extension-0.0.0-safari-mobile.zip safari-mv3",
    "zip:all": "npm run zip && npm run zip:firefox && npm run zip:edge && npm run zip:safari && npm run zip:safari-mobile",
    "clean": "rm -rf .output",
    "zip:opera": "wxt zip -b opera",
    "zip:brave": "wxt zip -b brave",
    "zip:duckduckgo": "wxt zip -b duckduckgo",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
    "prepare:store": "npm run clean && npm run zip:all",
    "check:types": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.11.0",
    "bowser": "^2.11.0",
    "jwt-decode": "^4.0.0",
    "moment": "^2.30.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "webext-redux": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@wxt-dev/module-react": "^1.1.3",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.1.1",
    "jest-environment-jsdom": "^30.1.1",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.40.0",
    "wxt": "^0.20.6"
  }
}
